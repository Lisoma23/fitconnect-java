{
  "info": {
    "_postman_id": "fitconnect-collection",
    "name": "FitConnect - Plateforme de Réservation de Cours de Sport",
    "description": "Collection Postman complète pour tester l'architecture FitConnect via la gateway (:8080).\n\nScénarios couverts :\n- Gestion des cours (class-service)\n- Réservation (booking-service) - pattern Saga\n- Paiement (payment-service)\n- Annulation avec remboursement\n- Scénarios d'erreur (409, 400)\n- Notifications (notification-service)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "classId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. Gestion des cours (class-service)",
      "item": [
        {
          "name": "Créer un cours",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yoga du matin\",\n  \"description\": \"Séance de yoga douce pour débuter la journée\",\n  \"instructor\": \"Marie\",\n  \"gymLocation\": \"Paris\",\n  \"category\": \"YOGA\",\n  \"level\": \"BEGINNER\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 10,\n  \"price\": 15.00,\n  \"dateTime\": \"2026-09-20T09:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Créer un cours → 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('currentParticipants initialisé à 0', function () {",
                  "    pm.expect(pm.response.json().currentParticipants).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set('classId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister les cours",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lister les cours → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrer les cours (category + level)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?category=YOGA&level=BEGINNER",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes"],
              "query": [
                { "key": "category", "value": "YOGA" },
                { "key": "level", "value": "BEGINNER" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Filtrer les cours → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Détails d'un cours",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Détails d'un cours → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Réservation (booking-service)",
      "item": [
        {
          "name": "Réserver un cours (2 places)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"userEmail\": \"john@example.com\",\n  \"userName\": \"John Doe\",\n  \"classId\": {{classId}},\n  \"numberOfSpots\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Réserver → 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Status = PENDING_PAYMENT', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT');",
                  "});",
                  "pm.test('totalAmount = price × spots', function () {",
                  "    pm.expect(pm.response.json().totalAmount).to.eql(30.00);",
                  "});",
                  "pm.collectionVariables.set('bookingId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Vérifier la réservation (PENDING_PAYMENT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vérifier la réservation → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status = PENDING_PAYMENT', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('PENDING_PAYMENT');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Paiement (booking-service + payment-service)",
      "item": [
        {
          "name": "Confirmer le paiement (carte valide)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardLastFour\": \"1234\",\n  \"transactionId\": \"txn_123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "confirm"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Confirmer le paiement → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status = CONFIRMED', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('CONFIRMED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Vérifier la réservation (CONFIRMED)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vérifier la réservation → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status = CONFIRMED', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('CONFIRMED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Annulation (dans les délais)",
      "item": [
        {
          "name": "Annuler la réservation",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Annuler → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status = CANCELLED', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('CANCELLED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Vérifier le remboursement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/booking/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "booking", "{{bookingId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vérifier le remboursement → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status = REFUNDED', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('REFUNDED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Vérifier les places libérées",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classes", "{{classId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vérifier les places libérées → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Scénarios d'erreur",
      "item": [
        {
          "name": "Surréservation (plus de places) → 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"userEmail\": \"alice@example.com\",\n  \"userName\": \"Alice\",\n  \"classId\": {{classId}},\n  \"numberOfSpots\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Surréservation → 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Paiement expiré → 409",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardLastFour\": \"1234\",\n  \"transactionId\": \"txn_expired\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "confirm"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Paiement expiré → 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Annulation hors délais → 409",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "{{bookingId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Annulation hors délais → 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cours inexistant → 400",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1,\n  \"userEmail\": \"john@example.com\",\n  \"userName\": \"John Doe\",\n  \"classId\": 999999,\n  \"numberOfSpots\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cours inexistant → 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Notifications (notification-service)",
      "item": [
        {
          "name": "Historique des notifications d'un utilisateur",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/notifications/user/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "user", "{{userId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Historique des notifications → 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
